{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Repo root, not upstream's "../" (here and in every package): the fork's collab/ imports
    // excalidraw-app/, and every package's program reaches it through @excalidraw/excalidraw.
    "rootDir": "../../",
    "outDir": "./dist/types"
  },
  "include": ["**/*"],
  "exclude": ["**/*.test.*", "tests", "types", "examples", "dist"]
}
